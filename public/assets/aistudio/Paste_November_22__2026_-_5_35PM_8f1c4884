} from '@/lib/supabase';
import QrModal from '@/components/QrModal';

export default function MasterPage() {
  const [activeTab, setActiveTab] = useState<'students' | 'laptops' | 'schedules'>('students');
  const [students, setStudents] = useState<Student[]>([]);
  const [laptops, setLaptops] = useState<Laptop[]>([]);
  const [schedules, setSchedules] = useState<Schedule[]>([]);
  const [loading, setLoading] = useState(true);

  // Form Siswa (Tanpa NISN — kode otomatis dari database)
  const [name, setName] = useState('');
  const [studentClass, setStudentClass] = useState('');
  const [photoUrl, setPhotoUrl] = useState('');

  // Form Laptop
  const [assetCode, setAssetCode] = useState('');
  const [brandModel, setBrandModel] = useState('');
  const [assignedStudentId, setAssignedStudentId] = useState('');

  // Form Jadwal
  const [purpose, setPurpose] = useState<LaptopPurpose>('Bimbel Kelas 10');
  const [targetClass, setTargetClass] = useState('10');
  const [dayOfWeek, setDayOfWeek] = useState(1);
  const [startTime, setStartTime] = useState('15:30');
  const [endTime, setEndTime] = useState('17:30');

  const [submitting, setSubmitting] = useState(false);
  const [formMsg, setFormMsg] = useState<string | null>(null);
  const [qrTarget, setQrTarget] = useState<{
    title: string;
    subtitle: string;
    value: string;
  } | null>(null);

  const fetchAll = useCallback(async () => {
    setLoading(true);
    const [{ data: sData }, { data: lData }, { data: schData }] = await Promise.all([
      supabase.from('students').select('*').order('student_code'),
      supabase
        .from('laptops')
        .select('*, students:assigned_student_id(id, name, class, student_code)')
        .order('asset_code'),
      supabase.from('schedules').select('*').order('day_of_week').order('start_time'),
    ]);
    setStudents(sData || []);
    setLaptops((lData as Laptop[]) || []);
    setSchedules((schData as Schedule[]) || []);
    setLoading(false);
  }, []);

  useEffect(() => {
    fetchAll();
  }, [fetchAll]);

  // Tambah Siswa Satuan (student_code dibuat otomatis oleh PostgreSQL)
  const handleAddStudent = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setFormMsg(null);

    const { data, error } = await supabase
      .from('students')
      .insert({
        name: name.trim(),
        class: studentClass.trim(),
        photo_url: photoUrl.trim() || null,
      })
      .select('student_code')
      .single();

    if (error) {
      setFormMsg(`Gagal: ${error.message}`);
    } else {
      setName('');
      setStudentClass('');
      setPhotoUrl('');
      setFormMsg(`Berhasil! Kode unik otomatis: ${data.student_code}`);
      await fetchAll();
    }
    setSubmitting(false);
  };

  // Unduh Template CSV Siswa
  const handleDownloadTemplate = () => {
    const csvContent = 'nama,kelas,photo_url\nRina Putri,10 IPA 2,\nFajar Pratama,11 IPS 1,\n';
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'template-upload-siswa.csv';
    link.click();
    URL.revokeObjectURL(url);
  };

  // Upload Template CSV Siswa (Kode unik otomatis terisi untuk semua baris)
  const handleCsvUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setSubmitting(true);
    setFormMsg(null);

    try {
      const text = await file.text();
      const lines = text
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter(Boolean);

      // Lewati baris header (nama,kelas,photo_url)
      const rows = lines.slice(1).map((line) => {
        const [nama, kelas, foto] = line.split(',').map((v) => v?.trim() || '');
        return {
          name: nama,
          class: kelas,
          photo_url: foto || null,
        };
      }).filter((r) => r.name && r.class);

      if (rows.length === 0) {
        setFormMsg('File CSV kosong atau format kolom tidak sesuai.');
        setSubmitting(false);
        return;
      }

      const { error } = await supabase.from('students').insert(rows);
      if (error) {
        setFormMsg(`Gagal upload: ${error.message}`);
      } else {
        setFormMsg(`${rows.length} siswa berhasil di-upload dengan kode unik otomatis!`);
        await fetchAll();
      }
    } catch {
      setFormMsg('Gagal membaca file CSV.');
    } finally {
      e.target.value = '';
      setSubmitting(false);
    }
  };

  // Tambah Laptop
  const handleAddLaptop = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setFormMsg(null);

    const { error } = await supabase.from('laptops').insert({
      asset_code: assetCode.trim().toUpperCase(),
      brand_model: brandModel.trim(),
      status: 'available',
      assigned_student_id: assignedStudentId || null,
    });

    if (error) {
      setFormMsg(`Gagal: ${error.message}`);
    } else {
      setAssetCode('');
      setBrandModel('');
      setAssignedStudentId('');
      setFormMsg('Laptop berhasil ditambahkan.');
      await fetchAll();
    }
    setSubmitting(false);
  };

  // Tambah Jadwal Pemakaian
  const handleAddSchedule = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setFormMsg(null);

    const { error } = await supabase.from('schedules').insert({
      purpose,
      target_class: targetClass.trim().toUpperCase(),
      day_of_week: Number(dayOfWeek),
      start_time: `${startTime}:00`,
      end_time: `${endTime}:00`,
      is_active: true,
    });

    if (error) {
      setFormMsg(`Gagal: ${error.message}`);
    } else {
      setFormMsg('Jadwal pemakaian berhasil ditambahkan.');
      await fetchAll();
    }
    setSubmitting(false);
  };

  const handleDeleteSchedule = async (id: string) => {
    await supabase.from('schedules').delete().eq('id', id);
    await fetchAll();
  };

  const assignedIds = new Set(laptops.map((l) => l.assigned_student_id).filter(Boolean));
  const unassignedStudents = students.filter((s) => !assignedIds.has(s.id));

  return (
    <div className="p-4">
      <header className="mb-4">
        <h1 className="text-lg font-bold text-slate-900">Data Master &amp; Jadwal</h1>
        <p className="text-xs text-slate-500">
          Kelola siswa (kode otomatis), laptop, dan jadwal peruntukan
        </p>
      </header>

      {/* 3 Tab Navigasi */}
      <div className="mb-4 grid grid-cols-3 rounded-xl bg-slate-200/70 p-1">
        <button
          onClick={() => {
            setActiveTab('students');
            setFormMsg(null);
          }}
          className={`flex items-center justify-center gap-1 rounded-lg py-2 text-xs font-semibold transition ${
            activeTab === 'students' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-600'
          }`}
        >
          <Users className="h-3.5 w-3.5" />
          Siswa
        </button>
        <button
          onClick={() => {
            setActiveTab('laptops');
            setFormMsg(null);
          }}
          className={`flex items-center justify-center gap-1 rounded-lg py-2 text-xs font-semibold transition ${
            activeTab === 'laptops' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-600'
          }`}
        >
          <LaptopIcon className="h-3.5 w-3.5" />
          Laptop
        </button>
        <button
          onClick={() => {
            setActiveTab('schedules');
            setFormMsg(null);
          }}
          className={`flex items-center justify-center gap-1 rounded-lg py-2 text-xs font-semibold transition ${
            activeTab === 'schedules' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-600'
          }`}
        >
          <CalendarClock className="h-3.5 w-3.5" />
          Jadwal
        </button>
      </div>

      {/* TAB 1: SISWA (INPUT SATUAN + UPLOAD CSV) */}
      {activeTab === 'students' && (
        <>
          <div className="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <h2 className="mb-2 text-sm font-bold text-slate-800">Upload Massal (Template CSV)</h2>
            <p className="mb-3 text-[11px] text-slate-500">
              Kode unik siswa (SIS-XXXX) dibuat otomatis saat file CSV di-upload.
            </p>
            <div className="grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={handleDownloadTemplate}
                className="flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 py-2 text-xs font-semibold text-slate-700 active:scale-95"
              >
                <Download className="h-3.5 w-3.5" />
                Unduh Template
              </button>
              <label className="flex cursor-pointer items-center justify-center gap-1.5 rounded-xl bg-emerald-600 py-2 text-xs font-semibold text-white active:scale-95">
                <Upload className="h-3.5 w-3.5" />
                Upload CSV
                <input
                  type="file"
                  accept=".csv"
                  onChange={handleCsvUpload}
                  className="hidden"
                  disabled={submitting}
                />
              </label>
            </div>
          </div>

          <form
            onSubmit={handleAddStudent}
            className="mb-5 space-y-2.5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
          >
            <h2 className="text-sm font-bold text-slate-800">Tambah Siswa Satuan</h2>
            <div className="grid grid-cols-2 gap-2">
              <input
                required
                type="text"
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder="Nama Lengkap"
                className="rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
              />
              <input
                required
                type="text"
                value={studentClass}
                onChange={(e) => setStudentClass(e.target.value)}
                placeholder="Kelas (cth: 10 IPA 1)"
                className="rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
              />
            </div>
            <input
              type="url"
              value={photoUrl}
              onChange={(e) => setPhotoUrl(e.target.value)}
              placeholder="URL Foto (opsional)"
              className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
            />
            <button
              type="submit"
              disabled={submitting}
              className="flex w-full items-center justify-center gap-1.5 rounded-xl bg-blue-600 py-2.5 text-sm font-semibold text-white active:scale-95 disabled:opacity-50"
            >
              <Plus className="h-4 w-4" />
              Simpan (Kode Unik Otomatis)
            </button>
            {formMsg && <p className="text-xs font-medium text-blue-600">{formMsg}</p>}
          </form>

          <div className="space-y-2.5">
            {students.map((s) => {
              const ownedLaptop = laptops.find((l) => l.assigned_student_id === s.id);
              return (
                <div
                  key={s.id}
                  className="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm"
                >
                  <div>
                    <h3 className="text-sm font-bold text-slate-900">{s.name}</h3>
                    <p className="text-xs text-slate-500">
                      Kode: <span className="font-mono font-bold text-slate-700">{s.student_code}</span>{' '}
                      &bull; Kelas {s.class}
                    </p>
                    <p className="mt-0.5 text-[11px] font-medium text-blue-600">
                      {ownedLaptop ? `Jatah: ${ownedLaptop.asset_code}` : 'Belum ada jatah laptop'}
                    </p>
                  </div>
                  <button
                    onClick={() =>
                      setQrTarget({
                        title: s.name,
                        subtitle: `Kartu Siswa — Kelas ${s.class}`,
                        value: s.student_code,
                      })
                    }
                    className="flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 active:scale-95"
                  >
                    <QrCode className="h-4 w-4" />
                    QR
                  </button>
                </div>
              );
            })}
          </div>
        </>
      )}

      {/* TAB 2: LAPTOP */}
      {activeTab === 'laptops' && (
        <>
          <form
            onSubmit={handleAddLaptop}
            className="mb-5 space-y-2.5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
          >
            <h2 className="text-sm font-bold text-slate-800">Tambah Laptop &amp; Hubungkan Siswa</h2>
            <div className="grid grid-cols-2 gap-2">
              <input
                required
                type="text"
                value={assetCode}
                onChange={(e) => setAssetCode(e.target.value)}
                placeholder="Kode (cth: LAP-004)"
                className="rounded-xl border border-slate-200 px-3 py-2 text-sm uppercase outline-none focus:border-blue-500"
              />
              <input
                required
                type="text"
                value={brandModel}
                onChange={(e) => setBrandModel(e.target.value)}
                placeholder="Merk / Tipe"
                className="rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
              />
            </div>
            <select
              value={assignedStudentId}
              onChange={(e) => setAssignedStudentId(e.target.value)}
              className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-500"
            >
              <option value="">-- Pilih Pemilik Siswa --</option>
              {unassignedStudents.map((s) => (
                <option key={s.id} value={s.id}>
                  {s.student_code} — {s.name} ({s.class})
                </option>
              ))}
            </select>
            <button
              type="submit"
              disabled={submitting}
              className="flex w-full items-center justify-center gap-1.5 rounded-xl bg-blue-600 py-2.5 text-sm font-semibold text-white active:scale-95 disabled:opacity-50"
            >
              <Plus className="h-4 w-4" />
              Simpan Laptop
            </button>
            {formMsg && <p className="text-xs font-medium text-blue-600">{formMsg}</p>}
          </form>

          <div className="space-y-2.5">
            {laptops.map((l) => (
              <div
                key={l.id}
                className="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm"
              >
                <div>
                  <div className="flex items-center gap-2">
                    <span className="font-mono text-sm font-bold text-slate-900">
                      {l.asset_code}
                    </span>
                    <span
                      className={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                        l.status === 'available'
                          ? 'bg-emerald-100 text-emerald-700'
                          : 'bg-amber-100 text-amber-700'
                      }`}
                    >
                      {l.status === 'available' ? 'Tersedia' : 'Dipinjam'}
                    </span>
                  </div>
                  <p className="text-xs text-slate-500">{l.brand_model}</p>
                  <p className="mt-0.5 text-[11px] font-medium text-slate-700">
                    Pemilik:{' '}
                    {l.students
                      ? `${l.students.name} (${l.students.student_code})`
                      : 'Belum ditentukan'}
                  </p>
                </div>
                <button
                  onClick={() =>
                    setQrTarget({
                      title: l.asset_code,
                      subtitle: `Stiker Tas Laptop — ${l.brand_model}`,
                      value: l.asset_code,
                    })
                  }
                  className="flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 active:scale-95"
                >
                  <QrCode className="h-4 w-4" />
                  QR
                </button>
              </div>
            ))}
          </div>
        </>
      )}

      {/* TAB 3: JADWAL & PERUNTUKAN */}
      {activeTab === 'schedules' && (
        <>
          <form
            onSubmit={handleAddSchedule}
            className="mb-5 space-y-2.5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
          >
            <h2 className="text-sm font-bold text-slate-800">Tambah Jadwal Pemakaian</h2>
            <select
              value={purpose}
              onChange={(e) => {
                const val = e.target.value as LaptopPurpose;
                setPurpose(val);
                if (val === 'Bimbel Kelas 10') setTargetClass('10');
                else if (val === 'Bimbel Kelas 11') setTargetClass('11');
                else if (val === 'Bimbel Kelas 12') setTargetClass('12');
                else setTargetClass('SEMUA');
              }}
              className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-500"
            >
              {LAPTOP_PURPOSES.map((p) => (
                <option key={p} value={p}>
                  {p}
                </option>
              ))}
            </select>

            <div className="grid grid-cols-2 gap-2">
              <select
                value={dayOfWeek}
                onChange={(e) => setDayOfWeek(Number(e.target.value))}
                className="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-500"
              >
                {DAYS_ID.map((day, idx) => (
                  <option key={day} value={idx}>
                    {day}
                  </option>
                ))}
              </select>
              <input
                required
                type="text"
                value={targetClass}
                onChange={(e) => setTargetClass(e.target.value)}
                placeholder="Target Kelas (10 / 11 / 12 / SEMUA)"
                className="rounded-xl border border-slate-200 px-3 py-2 text-sm uppercase outline-none focus:border-blue-500"
              />
            </div>

            <div className="grid grid-cols-2 gap-2">
              <div>
                <label className="mb-1 block text-[11px] text-slate-500">Jam Mulai</label>
                <input
                  required
                  type="time"
                  value={startTime}
                  onChange={(e) => setStartTime(e.target.value)}
                  className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
                />
              </div>
              <div>
                <label className="mb-1 block text-[11px] text-slate-500">Jam Selesai</label>
                <input
                  required
                  type="time"
                  value={endTime}
                  onChange={(e) => setEndTime(e.target.value)}
                  className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-blue-500"
                />
              </div>
            </div>

            <button
              type="submit"
              disabled={submitting}
              className="flex w-full items-center justify-center gap-1.5 rounded-xl bg-blue-600 py-2.5 text-sm font-semibold text-white active:scale-95 disabled:opacity-50"
            >
              <Plus className="h-4 w-4" />
              Simpan Jadwal
            </button>
            {formMsg && <p className="text-xs font-medium text-blue-600">{formMsg}</p>}
          </form>

          <div className="space-y-2.5">
            {schedules.map((sch) => (
              <div
                key={sch.id}
                className="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm"
              >
                <div>
                  <span className="inline-block rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-bold text-blue-700">
                    {sch.purpose}
                  </span>
                  <p className="mt-1 text-sm font-bold text-slate-900">
                    {DAYS_ID[sch.day_of_week]}, {sch.start_time.slice(0, 5)} –{' '}
                    {sch.end_time.slice(0, 5)}
                  </p>
                  <p className="text-xs text-slate-500">Target Kelas: {sch.target_class}</p>
                </div>
                <button
                  onClick={() => handleDeleteSchedule(sch.id)}
                  className="rounded-xl bg-red-50 p-2 text-red-600 active:scale-95"
                  title="Hapus jadwal"
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              </div>
            ))}
          </div>
        </>
      )}

      {qrTarget && (
        <QrModal
          title={qrTarget.title}
          subtitle={qrTarget.subtitle}
          value={qrTarget.value}
          onClose={() => setQrTarget(null)}
        />
      )}
    </div>
  );
}

```

