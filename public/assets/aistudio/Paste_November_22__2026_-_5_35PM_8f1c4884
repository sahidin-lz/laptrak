## 1. Pembaruan Struktur Database SQL (Supabase)

Jalankan skrip ini di **SQL Editor** Supabase (skrip ini akan mengganti tabel lama dengan struktur baru yang mendukung kode otomatis dan jadwal):

```sql
-- Bersihkan tabel lama jika sudah pernah dibuat sebelumnya
DROP TABLE IF EXISTS transactions CASCADE;
DROP TABLE IF EXISTS laptops CASCADE;
DROP TABLE IF EXISTS students CASCADE;
DROP TABLE IF EXISTS schedules CASCADE;
DROP SEQUENCE IF EXISTS student_code_seq;

-- Sequence untuk membuat Kode Unik Siswa otomatis (SIS-0001, SIS-0002, ...)
CREATE SEQUENCE student_code_seq START 1;

-- 1. Tabel Siswa (Tanpa NISN, menggunakan student_code otomatis)
CREATE TABLE students (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_code TEXT UNIQUE NOT NULL DEFAULT ('SIS-' || lpad(nextval('student_code_seq')::text, 4, '0')),
  name TEXT NOT NULL,
  class TEXT NOT NULL,
  photo_url TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Tabel Laptop (Terhubung 1-ke-1 dengan siswa pemilik)
CREATE TABLE laptops (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  asset_code TEXT UNIQUE NOT NULL,
  brand_model TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'available' CHECK (status IN ('available', 'borrowed')),
  assigned_student_id UUID UNIQUE REFERENCES students(id) ON DELETE SET NULL,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Tabel Jadwal & Peruntukan Pemakaian
CREATE TABLE schedules (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  purpose TEXT NOT NULL CHECK (
    purpose IN ('Bimbel Kelas 10', 'Bimbel Kelas 11', 'Bimbel Kelas 12', 'SUGT', 'Kegiatan Lainnya')
  ),
  target_class TEXT NOT NULL, -- Contoh: '10', '11', '12', '10 IPA 1', atau 'SEMUA'
  day_of_week INT NOT NULL CHECK (day_of_week BETWEEN 0 AND 6), -- 0=Minggu, 1=Senin ... 6=Sabtu
  start_time TIME NOT NULL,
  end_time TIME NOT NULL,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 4. Tabel Transaksi (Mencatat peruntukan dari jadwal yang cocok)
CREATE TABLE transactions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES students(id) ON DELETE CASCADE,
  laptop_id UUID NOT NULL REFERENCES laptops(id) ON DELETE CASCADE,
  purpose TEXT NOT NULL DEFAULT 'Kegiatan Lainnya',
  borrow_time TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  return_time TIMESTAMPTZ,
  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'returned'))
);

