## 3. Halaman Scan dengan Validasi Profil & Jadwal (`app/page.tsx`)

Saat kartu siswa (`SIS-0001`) dipindai, aplikasi langsung mengecek apakah saat ini masuk dalam jadwal yang diizinkan untuk kelas siswa tersebut. Jika tidak sesuai jadwal, proses pengambilan laptop otomatis diblokir.

```tsx
'use client';

import { useState, useCallback } from 'react';
import {
  CheckCircle2,
  XCircle,
  RotateCcw,
  UserCheck,
  Laptop as LaptopIcon,
  Keyboard,
  ShieldAlert,
  CalendarCheck,
  CalendarX,
} from 'lucide-react';
import QrScanner from '@/components/QrScanner';
import { supabase, Student, Laptop, Schedule, DAYS_ID } from '@/lib/supabase';
import { playFeedback } from '@/lib/sound';

type AlertState = {
  type: 'borrowed' | 'returned' | 'error';
  title: string;
  message: string;
} | null;

// Fungsi bantu: cek kecocokan jadwal saat ini dengan kelas siswa
function findMatchingSchedule(schedules: Schedule[], studentClass: string): Schedule | null {
  const now = new Date();
  const currentDay = now.getDay(); // 0-6
  const currentTime = now.toTimeString().slice(0, 8); // "HH:MM:SS"
  const normClass = studentClass.trim().toUpperCase();

  return (
    schedules.find((sch) => {
      if (!sch.is_active || sch.day_of_week !== currentDay) return false;
      if (currentTime < sch.start_time || currentTime > sch.end_time) return false;

      const target = sch.target_class.trim().toUpperCase();
      if (target === 'SEMUA' || target === 'ALL') return true;
      return normClass.startsWith(target) || normClass.includes(target);
    }) || null
  );
}

export default function ScanPage() {
  const [step, setStep] = useState<1 | 2>(1);
  const [scannedStudent, setScannedStudent] = useState<Student | null>(null);
  const [assignedLaptop, setAssignedLaptop] = useState<Laptop | null>(null);
  const [activeSchedule, setActiveSchedule] = useState<Schedule | null>(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [alert, setAlert] = useState<AlertState>(null);
  const [manualCode, setManualCode] = useState('');

  const resetProcess = useCallback(() => {
    setStep(1);
    setScannedStudent(null);
    setAssignedLaptop(null);
    setActiveSchedule(null);
    setAlert(null);
    setIsProcessing(false);
  }, []);

  const showAlertAndAutoReset = (nextAlert: NonNullable<AlertState>, autoResetMs = 3200) => {
    setAlert(nextAlert);
    setTimeout(() => {
      setAlert(null);
      if (nextAlert.type !== 'error') {
        setStep(1);
        setScannedStudent(null);
        setAssignedLaptop(null);
        setActiveSchedule(null);
      }
      setIsProcessing(false);
    }, autoResetMs);
  };

  const handleScanCode = async (code: string) => {
    const cleanCode = code.trim().toUpperCase();
    if (!cleanCode || isProcessing) return;

    setIsProcessing(true);
    setAlert(null);

    try {
      // ==========================================
      // LANGKAH 1: SCAN KODE UNIK KARTU SISWA (SIS-XXXX)
      // ==========================================
      if (step === 1) {
        const { data: student, error } = await supabase
          .from('students')
          .select('*')
          .eq('student_code', cleanCode)
          .single();

        if (error || !student) {
          playFeedback('error');
          showAlertAndAutoReset(
            {
              type: 'error',
              title: 'SISWA TIDAK TERDAFTAR',
              message: `Kode kartu "${cleanCode}" tidak ditemukan di sistem.`,
            },
            2800
          );
          return;
        }

        // Ambil jatah laptop dan jadwal aktif hari ini secara paralel
        const today = new Date().getDay();
        const [{ data: laptopJatah }, { data: todaySchedules }] = await Promise.all([
          supabase
            .from('laptops')
            .select('*')
            .eq('assigned_student_id', student.id)
            .maybeSingle(),
          supabase
            .from('schedules')
            .select('*')
            .eq('day_of_week', today)
            .eq('is_active', true),
        ]);

        const matchedSch = findMatchingSchedule((todaySchedules as Schedule[]) || [], student.class);

        playFeedback('scan');
        setScannedStudent(student);
        setAssignedLaptop(laptopJatah || null);
        setActiveSchedule(matchedSch);
        setStep(2);
        setIsProcessing(false);
        return;
      }

      // ==========================================
      // LANGKAH 2: SCAN TAS LAPTOP (VALIDASI PROFIL + JADWAL)
      // ==========================================
      if (step === 2 && scannedStudent) {
        const { data: laptop, error: laptopErr } = await supabase
          .from('laptops')
          .select('*, students:assigned_student_id(name, class, student_code)')
          .eq('asset_code', cleanCode)
          .single();

        if (laptopErr || !laptop) {
          playFeedback('error');
          showAlertAndAutoReset(
            {
              type: 'error',
              title: 'LAPTOP TIDAK TERDAFTAR',
              message: `Kode tas/laptop "${cleanCode}" tidak ditemukan.`,
            },
            3000
          );
          return;
        }

        // VALIDASI 1: KECOCOKAN PROFIL SISWA & TAS LAPTOP
        if (laptop.assigned_student_id !== scannedStudent.id) {
          playFeedback('error');
          const ownerInfo = laptop.students
            ? `${laptop.students.name} (${laptop.students.class})`
            : 'Belum dialokasikan ke siswa manapun';

          showAlertAndAutoReset(
            {
              type: 'error',
              title: 'SALAH TAS LAPTOP!',
              message: `${laptop.asset_code} terdaftar milik ${ownerInfo}, bukan milik ${scannedStudent.name}.`,
            },
            4000
          );
          return;
        }

        // JIKA STATUS AVAILABLE -> PROSES PENGAMBILAN (WAJIB CEK JADWAL!)
        if (laptop.status === 'available') {
          // VALIDASI 2: KESESUAIAN JADWAL PEMAKAIAN
          if (!activeSchedule) {
            playFeedback('error');
            const todayName = DAYS_ID[new Date().getDay()];
            showAlertAndAutoReset(
              {
                type: 'error',
                title: 'TIDAK SESUAI JADWAL!',
                message: `Hari ${todayName} jam ini bukan jadwal pemakaian laptop untuk kelas ${scannedStudent.class}. Pengambilan ditolak.`,
              },
              4200
            );
            return;
          }

          const { error: txErr } = await supabase.from('transactions').insert({
            student_id: scannedStudent.id,
            laptop_id: laptop.id,
            purpose: activeSchedule.purpose,
            status: 'active',
          });
          if (txErr) throw txErr;

          const { error: updErr } = await supabase
            .from('laptops')
            .update({ status: 'borrowed' })
            .eq('id', laptop.id);
          if (updErr) throw updErr;

          playFeedback('success');
          showAlertAndAutoReset({
            type: 'borrowed',
            title: 'COCOK — BERHASIL DIAMBIL',
            message: `${scannedStudent.name} mengambil ${laptop.asset_code} untuk ${activeSchedule.purpose}.`,
          });
          return;
        }

        // JIKA STATUS BORROWED -> PROSES PENGEMBALIAN (SELALU DIIZINKAN)
        if (laptop.status === 'borrowed') {
          const { data: activeTx } = await supabase
            .from('transactions')
            .select('id')
            .eq('student_id', scannedStudent.id)
            .eq('laptop_id', laptop.id)
            .eq('status', 'active')
            .order('borrow_time', { ascending: false })
            .limit(1)
            .maybeSingle();

          if (activeTx) {
            await supabase
              .from('transactions')
              .update({ return_time: new Date().toISOString(), status: 'returned' })
              .eq('id', activeTx.id);
          }

          await supabase
            .from('laptops')
            .update({ status: 'available' })
            .eq('id', laptop.id);

          playFeedback('return');
          showAlertAndAutoReset({
            type: 'returned',
            title: 'COCOK — BERHASIL DIKEMBALIKAN',
            message: `${laptop.asset_code} telah dikembalikan oleh ${scannedStudent.name}.`,
          });
          return;
        }
      }
    } catch (err) {
      console.error(err);
      playFeedback('error');
      showAlertAndAutoReset(
        {
          type: 'error',
          title: 'TERJADI KESALAHAN',
          message: 'Periksa koneksi internet Anda lalu coba scan ulang.',
        },
        3000
      );
    }
  };

  const handleManualSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!manualCode.trim()) return;
    handleScanCode(manualCode);
    setManualCode('');
  };

  return (
    <div className="p-4">
      <header className="mb-4 flex items-center justify-between">
        <div>
          <h1 className="text-lg font-bold text-slate-900">Scan Transaksi Laptop</h1>
          <p className="text-xs text-slate-500">Validasi Profil Siswa, Tas Laptop &amp; Jadwal</p>
        </div>
        {step === 2 && (
          <button
            onClick={resetProcess}
            className="inline-flex items-center gap-1.5 rounded-xl bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 active:scale-95"
          >
            <RotateCcw className="h-3.5 w-3.5" />
            Reset
          </button>
        )}
      </header>

      {/* Indikator Langkah */}
      <div className="mb-4 grid grid-cols-2 gap-2">
        <div
          className={`flex items-center gap-2 rounded-xl border p-2.5 text-xs font-semibold ${
            step === 1
              ? 'border-blue-500 bg-blue-50 text-blue-700'
              : 'border-emerald-200 bg-emerald-50 text-emerald-700'
          }`}
        >
          <UserCheck className="h-4 w-4 shrink-0" />
          <span>1. Scan Kartu Siswa</span>
        </div>
        <div
          className={`flex items-center gap-2 rounded-xl border p-2.5 text-xs font-semibold ${
            step === 2
              ? 'border-blue-500 bg-blue-50 text-blue-700'
              : 'border-slate-200 bg-white text-slate-400'
          }`}
        >
          <LaptopIcon className="h-4 w-4 shrink-0" />
          <span>2. Scan Tas Laptop</span>
        </div>
      </div>

      {/* Kamera Pemindai */}
      <div className="relative mb-4">
        <QrScanner onScan={handleScanCode} paused={isProcessing || Boolean(alert)} />

        {alert && (
          <div
            onClick={() => {
              setAlert(null);
              if (alert.type !== 'error') resetProcess();
              else setIsProcessing(false);
            }}
            className={`absolute inset-0 z-20 flex cursor-pointer flex-col items-center justify-center rounded-2xl p-6 text-center text-white shadow-xl ${
              alert.type === 'borrowed'
                ? 'bg-emerald-600/95'
                : alert.type === 'returned'
                ? 'bg-blue-600/95'
                : 'bg-red-600/95'
            }`}
          >
            {alert.type === 'error' ? (
              <XCircle className="mb-3 h-16 w-16" />
            ) : (
              <CheckCircle2 className="mb-3 h-16 w-16" />
            )}
            <h2 className="mb-1 text-xl font-extrabold">{alert.title}</h2>
            <p className="text-sm text-white/90">{alert.message}</p>
            <span className="mt-4 rounded-full bg-black/20 px-3 py-1 text-[11px]">
              Ketuk untuk lanjut
            </span>
          </div>
        )}
      </div>

      {/* Kartu Profil Siswa + Status Jadwal */}
      {step === 2 && scannedStudent && (
        <div className="mb-4 space-y-2.5 rounded-2xl border border-blue-200 bg-white p-4 shadow-sm">
          <div className="flex items-center gap-3.5">
            <img
              src={
                scannedStudent.photo_url ||
                `https://api.dicebear.com/9.x/initials/svg?seed=${encodeURIComponent(
                  scannedStudent.name
                )}`
              }
              alt={scannedStudent.name}
              className="h-14 w-14 rounded-full border-2 border-blue-100 bg-slate-100 object-cover"
            />
            <div className="flex-1">
              <span className="inline-block rounded-md bg-blue-50 px-2 py-0.5 font-mono text-[11px] font-bold text-blue-700">
                {scannedStudent.student_code}
              </span>
              <h3 className="text-base font-bold text-slate-900">{scannedStudent.name}</h3>
              <p className="text-xs text-slate-500">Kelas {scannedStudent.class}</p>
            </div>
          </div>

          {/* Status Jadwal */}
          {assignedLaptop?.status === 'borrowed' ? (
            <div className="flex items-center gap-2 rounded-xl bg-blue-50 p-2.5 text-xs font-semibold text-blue-700">
              <CalendarCheck className="h-4 w-4 shrink-0" />
              <span>Mode Pengembalian: Scan tas {assignedLaptop.asset_code} untuk mengembalikan.</span>
            </div>
          ) : activeSchedule ? (
            <div className="flex items-center gap-2 rounded-xl bg-emerald-50 p-2.5 text-xs font-semibold text-emerald-700">
              <CalendarCheck className="h-4 w-4 shrink-0" />
              <span>
                Jadwal Valid: <strong>{activeSchedule.purpose}</strong> (
                {activeSchedule.start_time.slice(0, 5)}–{activeSchedule.end_time.slice(0, 5)})
              </span>
            </div>
          ) : (
            <div className="flex items-center gap-2 rounded-xl bg-red-50 p-2.5 text-xs font-semibold text-red-700">
              <CalendarX className="h-4 w-4 shrink-0" />
              <span>Di luar jadwal pemakaian kelas {scannedStudent.class} — Pengambilan diblokir!</span>
            </div>
          )}

          {/* Info Tas Laptop Jatah */}
          <div className="rounded-xl bg-slate-50 p-3">
            {assignedLaptop ? (
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-[11px] font-medium text-slate-500">Tas Laptop Jatah:</p>
                  <p className="font-mono text-sm font-bold text-slate-900">
                    {assignedLaptop.asset_code}{' '}
                    <span className="font-sans font-normal text-slate-600">
                      — {assignedLaptop.brand_model}
                    </span>
                  </p>
                </div>
                <span
                  className={`rounded-full px-2.5 py-1 text-[11px] font-bold ${
                    assignedLaptop.status === 'available'
                      ? 'bg-emerald-100 text-emerald-700'
                      : 'bg-amber-100 text-amber-700'
                  }`}
                >
                  {assignedLaptop.status === 'available' ? 'Tersedia' : 'Dipinjam'}
                </span>
              </div>
            ) : (
              <div className="flex items-center gap-2 text-xs font-medium text-red-600">
                <ShieldAlert className="h-4 w-4 shrink-0" />
                <span>Siswa belum memiliki jatah laptop di Data Master.</span>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Input Manual */}
      <form onSubmit={handleManualSubmit} className="flex gap-2">
        <div className="relative flex-1">
          <Keyboard className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            value={manualCode}
            onChange={(e) => setManualCode(e.target.value)}
            placeholder={
              step === 1
                ? 'Ketik manual kode siswa (cth: SIS-0001)'
                : 'Ketik manual kode tas (cth: LAP-001)'
            }
            className="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm uppercase outline-none focus:border-blue-500"
          />
        </div>
        <button
          type="submit"
          disabled={isProcessing}
          className="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white active:scale-95 disabled:opacity-50"
        >
          Kirim
        </button>
      </form>
    </div>
  );
}

